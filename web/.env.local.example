# Copy to `.env.local` for local development, and set the same variable in Vercel's project
# settings for the deployed site. `NEXT_PUBLIC_` is required: the value is read in the browser,
# so it is inlined at build time and is not a secret. The API key never appears here — it lives
# only as a secret on the container that talks to the provider.
NEXT_PUBLIC_API_BASE=http://localhost:8000
